# Copy to .env for local overrides. Never commit real keys.

# Port for the Node API + WebSocket server (Vite uses 5173 in `npm run dev`)
PORT=8787

# local  = offline glossary + phrasebook (always available, no key)
# mymemory = free public demo API (rate-limited, no key; optional email below)
# deepl = DeepL API (requires DEEPL_API_KEY)
# google = Google Cloud Translation (requires GOOGLE_TRANSLATE_API_KEY)
# auto = DeepL if keyed, else Google if keyed, else MyMemory, else local
TRANSLATE_PROVIDER=auto

# Optional. MyMemory raises the daily character cap if a contact email is sent.
# This is not a secret API key.
MYMEMORY_EMAIL=

# DeepL. Use a key from your own DeepL account; never commit it.
# Free keys typically use https://api-free.deepl.com
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# Google Cloud Translation API key from your own GCP project.
GOOGLE_TRANSLATE_API_KEY=
